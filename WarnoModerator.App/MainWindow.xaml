<Window x:Class="WarnoModerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARNO UltiAI MODerator" Height="820" Width="1180" MinHeight="700" MinWidth="950"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WARNO UltiAI MODerator" FontSize="28" FontWeight="Bold" Foreground="#DDE5C5"/>
            <TextBlock Text="Combine installed Steam Workshop mods directly. UltiAI takes precedence; the base mod keeps its UI components when both provide them." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="WARNO folder" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="WarnoPathBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…" Click="Browse_Click"/>
                <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh mods" Click="Refresh_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Base mod" FontWeight="SemiBold"/><ComboBox x:Name="OtherModBox" ItemTemplate="{StaticResource ModComboItemTemplate}" SelectionChanged="Selection_Changed"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Priority mod (UltiAI)" FontWeight="SemiBold"/><ComboBox x:Name="UltiModBox" ItemTemplate="{StaticResource ModComboItemTemplate}" SelectionChanged="Selection_Changed"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Existing merge" FontWeight="SemiBold"/><ComboBox x:Name="ExistingMergeBox" DisplayMemberPath="OutputName" SelectionChanged="ExistingMerge_Changed"/></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="New mod name" FontWeight="SemiBold"/><TextBox x:Name="OutputNameBox" TextChanged="OutputName_Changed"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="15">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="Merge preview" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export report" Click="Export_Click" IsEnabled="False"/>
                    <CheckBox x:Name="ConflictsOnlyBox" DockPanel.Dock="Right" Content="Conflicts only" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <TextBlock Text="Search paths" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="SearchBox" ToolTip="Filter by file path, decision, winning mod, or reason" TextChanged="Filter_Changed"/>
                </DockPanel>
                <DataGrid x:Name="PreviewGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*"/>
                        <DataGridTemplateColumn Header="Decision" Width="135" SortMemberPath="ActionLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ActionPill" CornerRadius="3" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                            Background="#252D23" BorderBrush="#465442">
                                        <TextBlock x:Name="ActionPillText" Text="{Binding ActionLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#C8D0C0"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="UltiOverride">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#4D3C19"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#9E7B32"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#FFE4A3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="UltiOnly">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#283D1E"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#648C4D"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#D4F0C2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="OtherOverride">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#1D3E3A"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#3E8279"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#B3F0E6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="Identical">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#1C221B"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#384235"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#939E8C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="Delete">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#472121"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#8C4343"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#F5B8B8"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Winner" Binding="{Binding Winner}" Width="150"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Detail}" Width="340"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4"/>
            <Grid x:Name="ProgressPanel" Margin="4" Visibility="Collapsed">
                <ProgressBar x:Name="BusyBar" Height="22" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText" Text="Preparing · 0%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="11" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="CombineButton" Grid.Column="1" Content="Create as New" Click="Combine_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="UpdateButton" Content="Update and Rebuild" Click="Update_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/></StackPanel>
        </Grid>
        <Border Grid.Row="5" Background="{StaticResource LogBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="Transparent" Foreground="#D9E0CC" BorderThickness="0" FontFamily="Cascadia Mono,Consolas" FontSize="12"/>
        </Border>
    </Grid>
</Window>
