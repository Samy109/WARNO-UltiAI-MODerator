<Window x:Class="WarnoModerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARNO UltiAI MODerator" Height="900" Width="1360" MinHeight="720" MinWidth="1100"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="–"/>
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────────── Sidebar: what to combine ───────────── -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="24,24,24,20">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" BorderBrush="#35502A" BorderThickness="1">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UltiAI MODerator" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="Combine WARNO mods" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,20,0">
                    <StackPanel>
                        <!-- WARNO folder -->
                        <TextBlock Text="WARNO FOLDER" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WarnoPathBox" ToolTip="The folder WARNO is installed in"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8B7;" Margin="6,0,0,0"
                                    ToolTip="Choose the WARNO folder" Click="Browse_Click"/>
                            <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0"
                                    ToolTip="Rescan installed mods" Click="Refresh_Click"/>
                        </Grid>

                        <!-- Mods -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="MODS" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Text="Higher in the list wins conflicts" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AvailableModBox" ItemTemplate="{StaticResource ModComboItemTemplate}" MinHeight="44" MaxDropDownHeight="420"
                                      SelectionChanged="AvailableMod_SelectionChanged"/>
                            <Button x:Name="AddModButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="44" Height="44" Content="&#xE710;"
                                    Margin="6,0,0,0" ToolTip="Add the chosen mod" Click="AddMod_Click"/>
                        </Grid>

                        <Grid>
                            <ListBox x:Name="MergeOrderList" MinHeight="96" SelectionChanged="MergeOrder_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BackgroundBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Position}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Mod.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Mod.KindLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="5" Padding="7,2" Background="{StaticResource AccentSoftBrush}" BorderBrush="#35502A"
                                                    BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding PrimaryVisibility}">
                                                <TextBlock Text="PRIMARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="EmptyModsHint" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center"
                                           Text="Pick a mod above and add it. Add at least two to combine them."/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,8,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrimaryButton" ToolTip="Move the selected mod to the top so it wins every conflict" Click="MakePrimary_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Make primary"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE70E;" Margin="6,0,0,0" ToolTip="Move up" Click="MoveUp_Click"/>
                            <Button x:Name="DownButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70D;" Margin="6,0,0,0" ToolTip="Move down" Click="MoveDown_Click"/>
                            <Button x:Name="RemoveButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0" ToolTip="Remove from the list" Click="Remove_Click"/>
                        </Grid>

                        <!-- Output -->
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="New mod name" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="OutputNameBox" TextChanged="OutputName_Changed" Margin="0,0,0,14"/>
                        <TextBlock Text="Or rebuild an existing combined mod" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExistingMergeBox" DisplayMemberPath="OutputName" SelectionChanged="ExistingMerge_Changed"/>
                            <Button x:Name="DeleteMergeButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0"
                                    Foreground="{StaticResource DangerBrush}" Click="DeleteMerge_Click"
                                    ToolTip="Delete this combined mod from both Mods and Saved Games, with its leftovers"/>
                        </Grid>
                        <Button x:Name="CleanLeftoversButton" HorizontalAlignment="Left" Margin="0,0,0,24" Padding="10,4" MinHeight="28" FontSize="12"
                                Visibility="Collapsed" Click="CleanLeftovers_Click"
                                ToolTip="Delete folders left behind by interrupted or cancelled builds"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16,24,22">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="ProgressPanel" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="ProgressText" Text="Preparing" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="BusyBar" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                        <Button x:Name="CombineButton" Style="{StaticResource AccentButton}" Click="Combine_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Create combined mod"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UpdateButton" Content="Rebuild existing" Click="Update_Click" IsEnabled="False"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click" Visibility="Collapsed"
                                    Foreground="{StaticResource DangerBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ───────────── Main: the merge plan ───────────── -->
        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Merge plan" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Every file the combined mod will contain, and how each one is produced."/>
            </StackPanel>

            <!-- At a glance -->
            <Grid Grid.Row="1" Margin="0,0,-10,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="Files" Style="{StaticResource Caption}"/><TextBlock x:Name="StatFiles" Style="{StaticResource StatValue}"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="Delta merged" Style="{StaticResource Caption}"/><TextBlock x:Name="StatMerged" Style="{StaticResource StatValue}" Foreground="#9BD27A"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="Value conflicts" Style="{StaticResource Caption}"/><TextBlock x:Name="StatConflicts" Style="{StaticResource StatValue}" Foreground="#F0A86E"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="Priority overrides" Style="{StaticResource Caption}"/><TextBlock x:Name="StatOverrides" Style="{StaticResource StatValue}" Foreground="#E9C46A"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="From one mod" Style="{StaticResource Caption}"/><TextBlock x:Name="StatSingle" Style="{StaticResource StatValue}" Foreground="#7CC9BE"/></StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource StatTile}">
                    <StackPanel><TextBlock Text="Identical" Style="{StaticResource Caption}"/><TextBlock x:Name="StatIdentical" Style="{StaticResource StatValue}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                </Border>
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="460"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,0,10,0" TextChanged="Filter_Changed"
                             ToolTip="Filter by file or value path, decision, winning mod or reason"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="Search files, values, mods" Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <CheckBox x:Name="ConflictsOnlyBox" Grid.Column="2" Content="Conflicts only" VerticalAlignment="Center" Margin="16,0,16,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button x:Name="ExportButton" Grid.Column="3" Click="Export_Click" IsEnabled="False" ToolTip="Save the full plan as a JSON report">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Export report"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Plan table -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6,12,6,6">
                <Grid>
                    <DataGrid x:Name="PreviewGrid" IsReadOnly="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FILE" Binding="{Binding RelativePath}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="12"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="DECISION" Width="150" SortMemberPath="ActionLabel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Pill" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left" BorderThickness="1"
                                                Background="#1C2026" BorderBrush="#323844">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#9AA3B2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="PillText" Text="{Binding ActionLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#C9CED8"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ActionKey}" Value="Merged">
                                                <Setter TargetName="Pill" Property="Background" Value="#18261A"/>
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#2F4D2B"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#9BD27A"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="#BFE6A6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionKey}" Value="ValueConflict">
                                                <Setter TargetName="Pill" Property="Background" Value="#2A1D14"/>
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#5A3A22"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#F0A86E"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="#F6C7A0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionKey}" Value="Override">
                                                <Setter TargetName="Pill" Property="Background" Value="#272114"/>
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#54451F"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#E9C46A"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="#F1DA9C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionKey}" Value="Single">
                                                <Setter TargetName="Pill" Property="Background" Value="#14242A"/>
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#244650"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#7CC9BE"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="#AEE0D8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActionKey}" Value="Delete">
                                                <Setter TargetName="Pill" Property="Background" Value="#2B1718"/>
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="#5C2C2E"/>
                                                <Setter TargetName="Dot" Property="Fill" Value="#E5787A"/>
                                                <Setter TargetName="PillText" Property="Foreground" Value="#F2B3B4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="FROM" Binding="{Binding Winner}" Width="190">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="WHY" Binding="{Binding Detail}" Width="1.3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="EmptyPlan" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyPlanTitle" Text="No plan yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock x:Name="EmptyPlanText" Style="{StaticResource Caption}" TextAlignment="Center"
                                   Text="Add two or more mods on the left. The plan shows every file and every value the mods disagree on before anything is built."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activity -->
            <Expander x:Name="LogExpander" Grid.Row="4" Margin="0,14,0,0" IsExpanded="True" Foreground="{StaticResource TextBrush}">
                <Expander.Header>
                    <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabel}" Margin="0"/>
                </Expander.Header>
                <Border Background="{StaticResource LogBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,8,0,0" Height="150">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" Padding="0" Foreground="#C5CBD6"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalContentAlignment="Top">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</Window>
