<Window x:Class="WarnoModerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARNO UltiAI MODerator v1.5.0" Height="880" Width="1240" MinHeight="740" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="165"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="OpenModsFolderButton" Style="{StaticResource SmallSecondaryButtonStyle}" Content="Open WARNO\Mods" Click="OpenModsFolder_Click" ToolTip="Open local WARNO\Mods directory in Windows Explorer"/>
                <Button x:Name="OpenSavedModsButton" Style="{StaticResource SmallSecondaryButtonStyle}" Content="Open Saved Games Mods" Click="OpenSavedMods_Click" ToolTip="Open Saved Games\EugenSystems\WARNO\mod runtime directory in Windows Explorer"/>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WARNO UltiAI MODerator" FontSize="26" FontWeight="Bold" Foreground="#DDE5C5"/>
                    <Border Background="#2E3B28" BorderBrush="#657853" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.5.0" FontSize="11.5" FontWeight="SemiBold" Foreground="#CFE0A9"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Combine a Steam Workshop (or editable SDK) Base Mod with UltiAI. UltiAI takes priority on overlapping AI/gameplay databases, while the Base Mod keeps its custom UI and asset catalog."
                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1: WARNO Installation & Environment Summary -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WARNO Installation" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="WarnoPathBox" Grid.Column="1" VerticalContentAlignment="Center" ToolTip="Path to your steamapps\common\WARNO installation folder"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Browse…" Click="Browse_Click" ToolTip="Select WARNO installation folder"/>
                    <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Mods" Click="Refresh_Click" ToolTip="Rescan Workshop and editable SDK mods"/>
                </Grid>
                <TextBlock x:Name="EnvironmentSummaryText" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="2,5,2,0" TextTrimming="CharacterEllipsis"
                           Text="Locating WARNO installation and Workshop directories…"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Mod Selection & Target Output Configuration -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="1. Base Mod (Mod to Combine)" FontWeight="SemiBold" Margin="4,0,0,2"/>
                    <ComboBox x:Name="OtherModBox" ItemTemplate="{StaticResource ModComboItemTemplate}" SelectionChanged="Selection_Changed"
                              ToolTip="Choose the gameplay, division, or overhaul mod to combine with UltiAI"/>
                    <TextBlock x:Name="OtherModMetaText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,2,4,0" TextTrimming="CharacterEllipsis" Text="No base mod selected"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="2. Priority Mod (UltiAI)" FontWeight="SemiBold" Margin="4,0,0,2"/>
                    <ComboBox x:Name="UltiModBox" ItemTemplate="{StaticResource ModComboItemTemplate}" SelectionChanged="Selection_Changed"
                              ToolTip="Choose the UltiAI variant whose AI and gameplay databases take priority"/>
                    <TextBlock x:Name="UltiModMetaText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,2,4,0" TextTrimming="CharacterEllipsis" Text="No priority mod selected"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="3. Existing Combined Mod (Rebuild)" FontWeight="SemiBold" Margin="4,0,0,2"/>
                    <ComboBox x:Name="ExistingMergeBox" DisplayMemberPath="OutputName" SelectionChanged="ExistingMerge_Changed"
                              ToolTip="Select an existing combined mod created from this pair to update or rebuild"/>
                    <TextBlock x:Name="ExistingMergeMetaText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,2,4,0" TextTrimming="CharacterEllipsis" Text="None for selected mod pair"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="4. New Combined Mod Name (Create)" FontWeight="SemiBold" Margin="4,0,0,2"/>
                    <TextBox x:Name="OutputNameBox" TextChanged="OutputName_Changed"
                             ToolTip="Folder and mod name when clicking 'Create as New'"/>
                    <TextBlock x:Name="OutputNameMetaText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,2,4,0" TextTrimming="CharacterEllipsis" Text="Used by 'Create as New'"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Merge Preview & Precedence Breakdown -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Title & Breakdown Stat Pills -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#252E22" BorderBrush="#495742" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0,0,0" ToolTip="Total files in the combined plan">
                            <TextBlock x:Name="StatTotalText" Text="Total: 0" FontSize="11.5" Foreground="#E2E8D5"/>
                        </Border>
                        <Border Background="#4D3C19" BorderBrush="#9E7B32" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" ToolTip="Overlapping files where UltiAI replaces the Base Mod's version">
                            <TextBlock x:Name="StatOverrideText" Text="UltiAI Overrides: 0" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFE4A3"/>
                        </Border>
                        <Border Background="#283D1E" BorderBrush="#648C4D" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" ToolTip="Files supplied only by UltiAI and added to the combined mod">
                            <TextBlock x:Name="StatAddedText" Text="UltiAI Added: 0" FontSize="11.5" FontWeight="SemiBold" Foreground="#D4F0C2"/>
                        </Border>
                        <Border Background="#1D3E3A" BorderBrush="#3E8279" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" ToolTip="UI databases where the Base Mod's version is kept to preserve custom division emblems and interface textures">
                            <TextBlock x:Name="StatUiKeptText" Text="Base UI Kept: 0" FontSize="11.5" FontWeight="SemiBold" Foreground="#B3F0E6"/>
                        </Border>
                        <Border Background="#252D23" BorderBrush="#465442" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" ToolTip="Files supplied only by the Base Mod and kept unchanged">
                            <TextBlock x:Name="StatBaseKeptText" Text="Base Mod Kept: 0" FontSize="11.5" Foreground="#C8D0C0"/>
                        </Border>
                        <Border Background="#1C221B" BorderBrush="#384235" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" ToolTip="Overlapping files that are already byte-for-byte identical in both mods">
                            <TextBlock x:Name="StatIdenticalText" Text="Identical: 0" FontSize="11.5" Foreground="#9EA897"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Merge Plan &amp; File Precedence" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="ProvisionalBadge" Visibility="Collapsed" Background="#4A3B1C" BorderBrush="#9C7B38" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="At least one selected mod is an editable SDK source mod. WARNO will compile it during the build before final verification.">
                            <TextBlock Text="PROVISIONAL PREVIEW" FontSize="10.5" FontWeight="Bold" Foreground="#FFE29E"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Filter Bar -->
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Content="Export JSON Report" Click="Export_Click" IsEnabled="False"
                            ToolTip="Save the full merge decision table, warnings, and diagnostic log to a JSON file"/>
                    <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                    <CheckBox x:Name="UltiOnlyFilterBox" DockPanel.Dock="Right" Content="UltiAI changes only" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Show only files added or overridden by UltiAI"/>
                    <CheckBox x:Name="ConflictsOnlyBox" DockPanel.Dock="Right" Content="Conflicts only" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" ToolTip="Show only overlapping files where both mods supply different versions"/>
                    <TextBlock Text="Filter paths:" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="SearchBox" ToolTip="Filter by file path, category, winning mod, or action (e.g. NDF, Catalog, UI, Override)" TextChanged="Filter_Changed"/>
                </DockPanel>

                <!-- Merge Notes / Warnings Callout Banner -->
                <Border x:Name="WarningsBorder" Grid.Row="2" Visibility="Collapsed" Background="#282618" BorderBrush="#7A6832" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Merge Notes:" FontWeight="SemiBold" Foreground="#F3D98B" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="WarningsText" Foreground="#EBE3C5" TextWrapping="Wrap" FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Decisions Table -->
                <DataGrid x:Name="PreviewGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Decision" Width="135" SortMemberPath="ActionLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="ActionPill" CornerRadius="3" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                            Background="#252D23" BorderBrush="#465442">
                                        <TextBlock x:Name="ActionPillText" Text="{Binding ActionLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#C8D0C0"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="UltiOverride">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#4D3C19"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#9E7B32"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#FFE4A3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="UltiOnly">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#283D1E"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#648C4D"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#D4F0C2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="OtherOverride">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#1D3E3A"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#3E8279"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#B3F0E6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="Identical">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#1C221B"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#384235"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#939E8C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionKey}" Value="Delete">
                                            <Setter TargetName="ActionPill" Property="Background" Value="#472121"/>
                                            <Setter TargetName="ActionPill" Property="BorderBrush" Value="#8C4343"/>
                                            <Setter TargetName="ActionPillText" Property="Foreground" Value="#F5B8B8"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115"/>
                        <DataGridTextColumn Header="File Path" Binding="{Binding RelativePath}" Width="*" FontFamily="Cascadia Mono,Consolas" FontSize="12"/>
                        <DataGridTextColumn Header="Winning Mod" Binding="{Binding Winner}" Width="160"/>
                        <DataGridTextColumn Header="Precedence Reason" Binding="{Binding Detail}" Width="350"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Row 4: Status Banner & Primary Action Buttons -->
        <Grid Grid.Row="4" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBorder" Background="#1D251B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,4,8,4">
                <DockPanel>
                    <Border x:Name="StatusBadgeBorder" DockPanel.Dock="Left" Background="#2E3B28" BorderBrush="#657853" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadgeText" Text="READY" FontSize="11" FontWeight="Bold" Foreground="#CFE0A9"/>
                    </Border>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Grid x:Name="ProgressPanel" Margin="0,4,8,4" Visibility="Collapsed">
                <ProgressBar x:Name="BusyBar" Height="28" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText" Text="Preparing · 0%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="11.5" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="PreviewButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Preview" Click="Preview_Click"/>
            <Button x:Name="CombineButton" Grid.Column="2" Content="Create as New" Click="Combine_Click"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="UpdateButton" Content="Update and Rebuild" Click="Update_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Row 5: Activity & Diagnostic Log -->
        <Border Grid.Row="5" Background="{StaticResource LogBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OpenOutputButton" Style="{StaticResource SmallSecondaryButtonStyle}" Content="Open Selected Output" Click="OpenSelectedOutput_Click" ToolTip="Open the selected Existing Combined Mod folder in Windows Explorer"/>
                        <Button x:Name="CopyLogButton" Style="{StaticResource SmallSecondaryButtonStyle}" Content="Copy Log" Click="CopyLog_Click" ToolTip="Copy the diagnostic log to the clipboard"/>
                        <Button x:Name="ClearLogButton" Style="{StaticResource SmallSecondaryButtonStyle}" Content="Clear Log" Click="ClearLog_Click" ToolTip="Clear the diagnostic log output"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Activity &amp; Diagnostic Log" FontWeight="SemiBold" FontSize="12" Foreground="#B8C4A8"/>
                        <TextBlock x:Name="LogCountText" Text=" · Ready" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Background="Transparent" Foreground="#D9E0CC" BorderThickness="0" FontFamily="Cascadia Mono,Consolas" FontSize="11.5" Padding="2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
